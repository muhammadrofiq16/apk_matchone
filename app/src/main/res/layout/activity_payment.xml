<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#F8F8F8">

    <!-- ====== NAVIGATION HEADER ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#FFFFFF"
        android:elevation="1dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Kembali"
            android:layout_marginEnd="16dp"
            app:tint="#374151" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembayaran"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111827" />
    </LinearLayout>

    <!-- ====== SCROLLABLE MAIN CONTENT ====== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ====== BILLING CARD ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Tagihan"
                        android:textSize="16sp"
                        android:textColor="#4B5563" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTotalPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 80.000"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#37563b" />
            </LinearLayout>

            <!-- ====== VOUCHER BANNER ====== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="@drawable/bg_voucher_payment"
                android:layout_marginBottom="16dp">

                <!-- Voucher icon -->
                <LinearLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:background="@drawable/bg_voucher_icon_green"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎫"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Voucher Pengiriman Aktif"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#37563b" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hemat Rp 10rb"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#37563b" />
            </LinearLayout>

            <!-- ====== PAYMENT METHODS SECTION ====== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pilih Metode Pembayaran"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1F2937"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:layout_marginBottom="12dp" />

            <!-- ===== TRANSFER BANK GROUP ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:layout_marginBottom="12dp">

                <!-- Transfer Bank Header -->
                <LinearLayout
                    android:id="@+id/cardTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="57dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <View
                        android:id="@+id/radioTransfer"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_radio_unselected"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transfer Bank"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#374151" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/dividerTransfer"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:visibility="gone" />

                <!-- Sub-options container (hidden by default) -->
                <LinearLayout
                    android:id="@+id/transferSubOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="#F9FAFB"
                    android:visibility="gone">

                    <!-- BCA Virtual Account -->
                    <LinearLayout
                        android:id="@+id/optionBca"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_sub_option"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radioBca"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_radio_unselected"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BCA Virtual Account"
                            android:textSize="14sp"
                            android:textColor="#111827" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="#1A4789" />
                    </LinearLayout>

                    <!-- Mandiri Bill Payment -->
                    <LinearLayout
                        android:id="@+id/optionMandiri"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_sub_option"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radioMandiri"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_radio_unselected"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mandiri Bill Payment"
                            android:textSize="14sp"
                            android:textColor="#111827" />

                        <View
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:background="#003D79" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== E-WALLET GROUP ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_section_card"
                android:layout_marginBottom="12dp">

                <!-- E-Wallet Header -->
                <LinearLayout
                    android:id="@+id/cardEwallet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="58dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <View
                        android:id="@+id/radioEwallet"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:background="@drawable/bg_radio_unselected"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="E-Wallet (GoPay / ShopeePay /\nDana)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#374151" />

                    <!-- Wallet icons -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_blue" />

                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_orange_wallet"
                            android:layout_marginStart="-4dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:id="@+id/dividerEwallet"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#F3F4F6"
                    android:visibility="gone" />

                <!-- E-Wallet Sub-options (hidden by default) -->
                <LinearLayout
                    android:id="@+id/ewalletSubOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:background="#F9FAFB"
                    android:visibility="gone">

                    <!-- GoPay -->
                    <LinearLayout
                        android:id="@+id/optionGopay"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_sub_option"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radioGopay"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_radio_unselected"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="GoPay"
                            android:textSize="14sp"
                            android:textColor="#111827" />
                    </LinearLayout>

                    <!-- ShopeePay -->
                    <LinearLayout
                        android:id="@+id/optionShopeepay"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_sub_option"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radioShopeepay"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_radio_unselected"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ShopeePay"
                            android:textSize="14sp"
                            android:textColor="#111827" />
                    </LinearLayout>

                    <!-- Dana -->
                    <LinearLayout
                        android:id="@+id/optionDana"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:background="@drawable/bg_sub_option"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/radioDana"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:background="@drawable/bg_radio_unselected"
                            android:layout_marginEnd="12dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dana"
                            android:textSize="14sp"
                            android:textColor="#111827" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== COD OPTION ===== -->
            <LinearLayout
                android:id="@+id/cardCod"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/bg_section_card"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:id="@+id/radioCod"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/bg_radio_unselected"
                    android:layout_marginEnd="12dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bayar di Tempat (COD)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#374151" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💵"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- ===== BUKTI PEMBAYARAN (hidden for COD) ===== -->
            <LinearLayout
                android:id="@+id/proofSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_section_card"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bukti Pembayaran"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1F2937"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload screenshot atau foto bukti pembayaran agar kasir bisa mengkonfirmasi pesananmu."
                    android:textSize="12sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="12dp" />

                <ImageView
                    android:id="@+id/ivProofPreview"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginBottom="12dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:background="#F3F4F6"
                    android:contentDescription="Preview bukti pembayaran" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectProof"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Pilih Bukti Pembayaran"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    android:textColor="#37563b"
                    app:strokeColor="#37563b"
                    app:strokeWidth="1dp"
                    app:cornerRadius="10dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ====== FOOTER ACTION ====== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Konfirmasi Pesanan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:enabled="false"
            android:alpha="0.5"
            app:backgroundTint="#37563b"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>